rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CBS data contains passenger PII and is accessed only by the trusted API
    // service account. Browser clients must never read or write it directly.
    match /cbsCases/{document=**} { allow read, write: if false; }
    match /cbsOnHandCases/{document=**} { allow read, write: if false; }
    match /cbsWorldTracerCases/{document=**} { allow read, write: if false; }
    match /cbsMissingBagReports/{document=**} { allow read, write: if false; }
    match /cbsWrongBaggageCases/{document=**} { allow read, write: if false; }
  }
}
